#Theano Test Program
# Import required libraries
import numpy
import theano
import theano.tensor as T
from theano import function
 
# Declare two scalar variables
x = T.dscalar('x')
y = T.dscalar('y')
 
# Perform addition
z = x + y
 
# Create a callable function
f = function([x, y], z)
 
# Display result
print("Addition of two numbers:", f(5, 7))
 
